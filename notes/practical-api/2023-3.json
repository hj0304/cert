 라인"],"round_no":3,"round_label":"정보처리기사 실기 2023년 3회","card_label":null,"year":2023,"part":null,"unit_no":10,"unit_name":"Java","group_key":"lang-java","group_name":"Java"},{"id":"e1830a43791bf0ddd3606bc7","unit_id":"bb0d3f46525805dfcc917118","ref":"info-processing-practical-2023-3-c-4","number":20,"type":"서술형","points":5,"body_html":"<div class=\"q-text\">아래 코드의 출력값을 작성하시오.</div><pre class=\"qcode\"><code class=\"language-c\">#include &lt;stdio.h&gt;\nint main() {\n    char* p = \"KOREA\";\n    printf(\"%s\\n\", p);\n    printf(\"%s\\n\", p+1);\n    printf(\"%c\\n\", *p);\n    printf(\"%c\\n\", *(p+3));\n    printf(\"%c\\n\", *p+4);\n}</code></pre>","choices":[],"answer_no":null,"answer_text":"KOREA\nOREA\nK\nE\nO","answer_aliases":[],"answer_num":null,"round_digits":null,"tolerance":null,"dataset":null,"model":null,"code":null,"code_lang":null,"keywords":["c","pointer","char* 포인터 · %s %c 출력"],"round_no":3,"round_label":"정보처리기사 실기 2023년 3회","card_label":null,"year":2023,"part":null,"unit_no":9,"unit_name":"C언어","group_key":"lang-c","group_name":"C언어"}]}