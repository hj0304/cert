  int x = 4000;\n  Child() {\n    this(5000);\n  }\n  Child(int x) {\n    this.x = x;\n  }\n}\n\npublic class Main {\n  public static void main(String[] args) {\n    Child obj = new Child();\n    System.out.println(obj.getX());\n  }\n}</code></pre>","choices":[],"answer_no":null,"answer_text":"500","answer_aliases":[],"answer_num":null,"round_digits":null,"tolerance":null,"dataset":null,"model":null,"code":null,"code_lang":null,"keywords":["java","inherit","생성자 체이닝과 상속 변수 은닉"],"round_no":1,"round_label":"정보처리기사 실기 2023년 1회","card_label":null,"year":2023,"part":null,"unit_no":10,"unit_name":"Java","group_key":"lang-java","group_name":"Java"},{"id":"5d28694b83a352fb3872db95","unit_id":"bb0d3f46525805dfcc917118","ref":"info-processing-practical-2023-1-c-3","number":18,"type":"서술형","points":5,"body_html":"<div class=\"q-text\">빈칸 (a)(b)를 작성하시오.</div><pre class=\"qcode\"><code class=\"language-c\">#include &lt;stdio.h&gt;\nint main() {\n    int input = 101110;\n    int di = 1;\n    int sum = 0;\n    while (1) {\n        if (input == 0) break;\n        else {\n            sum = sum + (input (a)(b)) * di;  // ← 빈칸\n            di = di * 2;\n            input = input / 10;\n        }\n    }\n    printf(\"%d\", sum);\n    return 0;\n}</code></pre>","choices":[],"answer_no":null,"answer_text":"(a) %  (b) 10\n또는 (a) &  (b) 1","answer_aliases":[],"answer_num":null,"round_digits":null,"tolerance":null,"dataset":null,"model":null,"code":null,"code_lang":null,"keywords":["c","recur","이진수→십진수 변환 (빈칸)"],"round_no":1,"round_label":"정보처리기사 실기 2023년 1회","card_label":null,"year":2023,"part":null,"unit_no":9,"unit_name":"C언어","group_key":"lang-c","group_name":"C언어"},{"id":"6efd1648e3c1d2eed74e22a1","unit_id":"330331701cdca0278079d6c7","ref":"info-processing-practical-2023-1-java-3","number":19,"type":"서술형","points":5,"body_html":"<div class=\"q-text\">아래 코드의 출력값을 작성하시오.</div><pre class=\"qcode\"><code class=\"language-java\">abstract class Vehicle {\n    String name;\n    abstract public String getName(String val);\n    public String getName() {\n        return \"Vehicle name: \" + name;\n    }\n}\nclass Car extends Vehicle {\n    public Car(String val) {\n        name = super.name = val;\n    }\n    public String getName(String val) {\n        return \"Car name:\" + val;\n    }\n}\npublic class Main {\n    public static void main(String[] args) {\n        Vehicle obj = new Car(\"Spark\");\n        System.out.println(obj.getName());\n    }\n}</code></pre>","choices":[],"answer_no":null,"answer_text":"Vehicle name: Spark","answer_aliases":[],"answer_num":null,"round_digits":null,"tolerance":null,"dataset":null,"model":null,"code":null,"code_lang":null,"keywords":["java","inherit","abstract · super · 오버라이딩"],"round_no":1,"round_label":"정보처리기사 실기 2023년 1회","card_label":null,"year":2023,"part":null,"unit_no":10,"unit_name":"Java","group_key":"lang-java","group_name":"Java"},{"id":"752ba8d17ab40eabfa9a50c6","unit_id":"330331701cdca0278079d6c7","ref":"info-processing-practical-2023-1-java-4","number":20,"type":"서술형","points":5,"body_html":"<div class=\"q-text\">다음 Java 프로그램에서 빈칸 (1)과 (2)에 들어갈 코드를 쓰시오.</div><pre class=\"qcode\"><code class=\"language-java\">public class Sort {\n  public static void swap(int[] arr, int idx1, int idx2) {\n    int temp = arr[idx1];\n    arr[idx1] = arr[idx2];\n    arr[(  ①  )] = temp;\n  }\n\n  public static void Usort(int[] array, int length) {\n    for (int i = 0; i &lt; length; i++) {\n      for (int j = 0; j &lt; length - i - 1; j++) {\n        if (array[j] &gt; array[j + 1]) {\n          swap(array, j, j + 1);\n        }\n      }\n    }\n  }\n\n  public static void main(String[] args) {\n    int[] item = new int[] { 5, 3, 8, 1, 2, 7 };\n    int nx = 6;\n    Usort(item, (  ②  ));\n    for (int data : item) {\n      System.out.print(data + \" \");\n    }\n  }\n}</code></pre>","choices":[],"answer_no":null,"answer_text":"① idx2\n② nx","answer_aliases":[],"answer_num":null,"round_digits":null,"tolerance":null,"dataset":null,"model":null,"code":null,"code_lang":null,"keywords":["java","array","버블정렬 swap 빈칸"],"round_no":1,"round_label":"정보처리기사 실기 2023년 1회","card_label":null,"year":2023,"part":null,"unit_no":10,"unit_name":"Java","group_key":"lang-java","group_name":"Java"}]}